# Copia este archivo como .env y completa los valores.

# Servidor
PORT=8080
NODE_ENV=development

# Base de datos · Neon (PostgreSQL)
# Ambas URLs salen del panel de Neon -> "Connect".
# DATABASE_URL          -> conexión pooled (host con "-pooler"), la usa la app.
# DATABASE_URL_UNPOOLED -> conexión directa (sin "-pooler"), la usa Prisma CLI para migraciones.
DATABASE_URL="postgresql://USUARIO:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL_UNPOOLED="postgresql://USUARIO:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Autenticación · genera uno con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia-este-valor-por-uno-aleatorio-largo
JWT_EXPIRES_IN=1d
